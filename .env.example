# Copy to .env (ignored by git). Never commit real values.
# Session-mode pooler URL for Supabase (port 5432), or local Postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Local Postgres used only by the test suite (never point this at production).
DATABASE_URL_TEST=postgresql://USER:PASSWORD@localhost:5432/personal_agent_test
GEMINI_API_KEY=
# Optional review email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
